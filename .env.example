# Domínio público apontando para o IP do servidor (Caddy emite o HTTPS sozinho).
# Sem domínio, deixe "localhost" para testar localmente.
DOMAIN=karaoke.exemplo.com.br

# Login da área /gerenciar e das gravações. Gere o hash com:
#   docker run --rm caddy caddy hash-password --plaintext 'sua-senha'
# ATENÇÃO: cada "$" do hash precisa ser escrito "$$" neste arquivo.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
