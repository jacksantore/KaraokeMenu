{$DOMAIN:localhost} {
	encode zstd gzip

	# Leitura (busca, listagem, prévia) é pública. Cadastro/edição/exclusão exigem senha.
	@admin_page path /gerenciar /gerenciar/*
	@admin_write {
		path /api/songs /api/songs/*
		not method GET HEAD
	}
	basic_auth @admin_page {
		{$ADMIN_USER} {$ADMIN_PASSWORD_HASH}
	}
	basic_auth @admin_write {
		{$ADMIN_USER} {$ADMIN_PASSWORD_HASH}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy app:3000
}
